# Resend API key — https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxx

# Verified sender address in Resend (domain must be verified)
# Example: SALI Innovation <contact@salinnovation.com>
RESEND_FROM="SALI Innovation <jamel@salinnovation.com>"

# Google reCAPTCHA v3 — https://www.google.com/recaptcha/admin
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=your_site_key
RECAPTCHA_SECRET_KEY=your_secret_key
